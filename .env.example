# Gemini API Configuration
# Optional: leave blank for demo mode (no live AI, no live monitoring)
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-2.5-flash

# Optional second live provider. If Gemini is unavailable/rate-limited,
# SentinelX can fall back to Groq for the analyst explanation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# AI routing. One live call is made when the analyst clicks Explain with Live AI.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ENABLED=true

# Database Configuration
DATABASE_PATH=./database/procsee.db
EVIDENCE_STORAGE_PATH=./evidence_storage

# Agent Configuration
LOG_RETENTION_HOURS=6.0
INVESTIGATION_DEPTH=STANDARD
MAX_CONCURRENT_INVESTIGATIONS=3
AUTO_INVESTIGATE=false
# Safety: API keys alone do not start continuous Windows monitoring.
ENABLE_LIVE_MONITORING=false

# Beta Features (not recommended for production)
ENABLE_BETA_PREVENTION=false
